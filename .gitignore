# Supabase CLI scratch / local state (not source)
supabase/.temp/
supabase/.branches/
supabase/supabase/

# OS / editor cruft
.DS_Store
Thumbs.db

# Screenshot tooling: deps and local review sheets are regenerable, not source
tools/node_modules/
tools/package-lock.json
tools/sheet-*.png

# Review gallery is a generated review aid, not source
tools/review-gallery.html
tools/verify-*.png
tools/snap-*.json

# Test byproducts. The suites in tools/ write screenshots and PDFs next to the real
# assets; an underscore prefix keeps them out of the published site.
assets/screenshots/_*
tools/_*
